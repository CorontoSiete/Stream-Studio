<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Style x:Key="TopControlButtonBase" TargetType="{x:Type primitives:ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StudioFocusVisualStyle}" />
        <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource StudioCornerSmall}" />
                        <Border x:Name="InteractionLayer" Background="{DynamicResource StudioTextBrush}"
                                CornerRadius="{DynamicResource StudioCornerSmall}" Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20">
                                <Grid Width="24" Height="24">
                                    <Path Style="{DynamicResource StudioLineIcon}" Width="24" Height="24"
                                          Stretch="None" StrokeThickness="2"
                                          Stroke="{TemplateBinding Foreground}"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Viewbox>
                            <ContentPresenter x:Name="InlineLabel" Grid.Column="1"
                                              Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="OverflowLabel" Grid.Column="1"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="InlineLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ToolBar.IsOverflowItem" Value="True">
                            <Setter TargetName="InlineLabel" Property="Margin" Value="10,0,0,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ToolBar.IsOverflowItem" Value="True" />
                                <Condition Property="Content" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OverflowLabel" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InteractionLayer" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InteractionLayer" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InteractionLayer" Property="Opacity" Value="0" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource StudioDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource StudioDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ToolBar.IsOverflowItem" Value="True">
                <Setter Property="Width" Value="216" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResponsiveToolBarOverflowButton" TargetType="ToggleButton" BasedOn="{StaticResource TopControlButtonBase}">
        <Setter Property="Tag" Value="{DynamicResource StudioIconMore}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Real ToolBar items move into the overflow popup and retain their commands,
         bindings, focus handling and automation peers when space runs out. -->
    <Style x:Key="ResponsiveToolBar" TargetType="ToolBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" />
                        <ToggleButton x:Name="OverflowButton" Grid.Column="1"
                                      Style="{StaticResource ResponsiveToolBarOverflowButton}"
                                      IsChecked="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip="More controls" AutomationProperties.Name="More controls" />
                        <Popup x:Name="PART_ToolBarOverflowPopup"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowButton}"
                               IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               StaysOpen="False" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource StudioSurface1Brush}"
                                    BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8">
                                <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="240"
                                                      KeyboardNavigation.TabNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="False">
                            <Setter TargetName="OverflowButton" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
